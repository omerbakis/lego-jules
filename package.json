{
  "name": "lego-collection",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@9.5.0",
  "scripts": {
    "start:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/start.ps1",
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter web test:e2e && pnpm --filter api test:e2e",
    "db:migrate": "pnpm --filter @lego/database run db:migrate",
    "db:seed": "pnpm --filter @lego/database run db:seed",
    "db:studio": "pnpm --filter @lego/database run db:studio"
  }
}